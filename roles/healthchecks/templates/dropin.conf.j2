# Managed by Ansible (IncServer repo, roles/healthchecks). Pings healthchecks.io check "{{ item.key }}".
[Service]
# `+`: as root even when the job runs as a Tenant user (the URL file is root-only, 0600).
ExecStartPre=+-/usr/local/sbin/hc-ping {{ item.key }} start
ExecStopPost=+-/usr/local/sbin/hc-ping {{ item.key }} stop{{ (' ' ~ item.success_stamp) if item.success_stamp is defined else '' }}

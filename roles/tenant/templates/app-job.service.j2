{% set t, e, job = item.0.0, item.0.1, item.1 %}
{% set home = '/var/www/' ~ t.domain ~ '/' ~ e.name %}
# Managed by Ansible (IncServer repo, roles/tenant). Scheduled app job, run by app-{{ e.user }}-{{ job.name }}.timer.
[Unit]
Description={{ t.label }} {{ e.name }}: POST /api/cron/{{ job.name }}
After=pm2-{{ e.user }}.service
# No release yet (new Environment before its first deploy): skipped, not failed.
ConditionPathExists={{ home }}/current/scripts/deploy-env.mjs

[Service]
Type=oneshot
User={{ e.user }}
WorkingDirectory={{ home }}/current
Environment=NODE_ENV=production
ExecStart=/usr/local/sbin/tenant-app-job {{ e.port }} {{ job.name }}
# Sandbox (`systemd-analyze security` 1.3, target <= 4.0): the job only reads its release (node) and curls
# 127.0.0.1. The healthchecks drop-in's `+` hc-ping runs as root outside the namespaces and the seccomp filters, but
# cgroup-wide settings reach it: PrivateDevices= and ProtectClock= imply DevicePolicy=closed (hc-ping only uses
# /dev/null), and there is no IPAddressDeny= (hc-ping talks to healthchecks.io). Left out on purpose:
# MemoryDenyWriteExecute= (V8's JIT needs writable + executable memory: node dies with SIGTRAP), ProcSubset=pid
# (hides /proc/cpuinfo and /proc/stat from node's os.cpus(), for no change in the score).
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

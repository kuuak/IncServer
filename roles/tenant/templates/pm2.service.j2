{% set home = '/var/www/' ~ item.0.domain ~ '/' ~ item.1.name %}
{% set path = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin' %}
{% set pm2 = '/usr/lib/node_modules/pm2/bin/pm2' %}
[Unit]
Description=PM2 process manager
Documentation=https://pm2.keymetrics.io/
After=network.target

[Service]
Type=forking
User={{ item.1.user }}
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
Environment=PATH={{ path }}
Environment=PM2_HOME={{ home }}/.pm2
PIDFile={{ home }}/.pm2/pm2.pid
Restart=on-failure

ExecStart={{ pm2 }} resurrect
ExecReload={{ pm2 }} reload all
ExecStop={{ pm2 }} kill

[Install]
WantedBy=multi-user.target

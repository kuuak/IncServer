# Managed by Ansible (IncServer repo, roles/motd). Read by motd-collect and incserver-status; no secrets here.
# Ports come from the nginx port map (/etc/nginx/conf.d/app-ports-map.conf), by host.
name {{ motd_name }}
title {{ motd_name }} · {{ motd_subtitle }}
subtitle {{ motd_subtitle }}
backup {{ motd_backup_label }}
web {{ nginx_tool_sites | join(' ') }}
{% for s in motd_services %}
service {{ s.label }} {{ s.unit if s.unit is defined else 'docker:' ~ s.container }}
{% endfor %}
{% for j in tenant_app_jobs %}
job {{ j.name }} {{ motd_job_labels[j.name] | default(j.name) }}
{% endfor %}
# env <tenant> <environment> <user> <home> <host> <app jobs>
{% for t in tenants %}
{% for e in t.environments %}
env {{ t.name }} {{ e.name }} {{ e.user }} /var/www/{{ t.domain }}/{{ e.name }} {{ e.host }} {{ (e.app_jobs | default(tenant_app_jobs | map(attribute='name'))) | join(',') or '-' }}
{% endfor %}
{% endfor %}
# open <days> <from> <to>, Europe/Zurich (motd_opening_hours)
{% for h in motd_opening_hours %}
open {{ h.days }} {{ h.from }} {{ h.to }}
{% endfor %}
